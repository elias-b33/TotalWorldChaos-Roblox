	["🔁"] = "reroll",
	["📺"] = "video",
	["🧱"] = "border",
	["🖼"] = "frame",
	-- navies (toasts and refusals: "⚓ Zephyr blockades Aurora Landing!")
	["⛵"] = "ship",
	["🚢"] = "ship",
	["⚓"] = "anchor",
	-- battles: a side's morale
	["💪"] = "morale",
} :: { [string]: string }

local function rgba(c: number): number
	local r, g, b = bit32.rshift(c, 16), bit32.band(bit32.rshift(c, 8), 255), bit32.band(c, 255)
	return 255 * 16777216 + b * 65536 + g * 256 + r
end

-- The rows of an icon (variants resolved), or nil for an unknown name.
function IconArt.rows(name: string): { string }?
	local rows = IconArt.ICONS[name]
	if rows then
		return rows
	end
	local variant = IconArt.VARIANTS[name]
	if variant == nil then
		return nil
	end
	local base = IconArt.ICONS[variant[1]]
	local map = variant[2] :: { [string]: string }
	local out = table.create(#base)
	for i, row in base do
		out[i] = (string.gsub(row, ".", function(ch: string): string
			return map[ch] or ch
		end))
	end
	return out
end

-- Every icon name, sorted.
function IconArt.names(): { string }
	local out = {}
	for name in IconArt.ICONS do
		table.insert(out, name)
	end
	for name in IconArt.VARIANTS do
		table.insert(out, name)
	end
	table.sort(out)
	return out
end

-- An icon's pixels: (RGBA buffer, width, height). Unknown names paint nothing (all transparent).
function IconArt.paint(name: string): (buffer, number, number)
	local size = IconArt.SIZE
	local out = buffer.create(size * size * 4) -- zero = transparent
	local rows = IconArt.rows(name)
	if rows == nil then
		return out, size, size
	end
	for y = 1, math.min(#rows, size) do
		local row = rows[y]
		for x = 1, math.min(#row, size) do
			local colour = IconArt.PALETTE[string.sub(row, x, x)]
			if colour then
				buffer.writeu32(out, ((y - 1) * size + x - 1) * 4, rgba(colour))
			end
		end
	end
	return out, size, size
end

-- If `text` starts with a known emoji (and a space), the icon for it and the rest of the text.
function IconArt.split(text: string): (string?, string)
	local first = string.match(text, "^[^%s%w%p]+")
	if first == nil then
		return nil, text
	end
	local key = string.gsub(first, "\u{FE0F}", "") -- emoji presentation selector
	local icon = IconArt.EMOJI[key]
	if icon == nil then
		return nil, text
	end
	local rest = string.gsub(string.sub(text, #first + 1), "^%s+", "")
	return icon, rest
end

return IconArt
